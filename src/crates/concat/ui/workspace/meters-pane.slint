// The VU meters: how loud the timeline plays, left and right, while it
// plays. A slim column beside the timeline by default. Each bar is the
// peak level on a decibel scale - 0 dB at the top, -60 at the foot -
// with the loudest of the last moment held as a line, and a light at the
// top that shows the held peak in dB and stays red once the mix has
// clipped, until it is clicked.

import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Fmt } from "../util.slint";
import { LevelMeter } from "../primitives/level-meter.slint";
import { Tip } from "../primitives/tooltip.slint";
import { Pane } from "pane.slint";
import { PaneKind, PaneSwitcher } from "pane-switcher.slint";

/// The levels, published by Rust (concat's meters.rs) thirty times a second
/// while anything plays. Each is `0..1` on the meter's decibel scale.
export global Meters {
    in property <float> left;
    in property <float> right;
    /// The loudest of the last moment, held; negative hides it.
    in property <float> hold-left: -1;
    in property <float> hold-right: -1;
    /// A sample reached full scale since the light was last cleared.
    in property <bool> clipped;
    callback clip-cleared();
}

export component MetersPane inherits Pane {
    in property <int> pane-seat;
    in property <bool> pane-removable;
    callback pane-picked(kind: PaneKind);
    callback pane-removed();

    /// The scale's floor, in dB: the meters' 0 is this, their 1 is 0 dB.
    property <float> floor-db: -60;
    property <[int]> ticks: [0, -3, -6, -9, -12, -15, -18, -21, -24, -27, -30, -33, -36, -39, -42, -45, -48, -51, -54, -57, -60];
    property <[int]> marks: [0, -6, -12, -18, -24, -36, -48, -60];

    // Fit the dock's 64px minimum: 22px ruler, two 12px bars, two
    // 3px gaps and 6px padding per side. The peak shares the clip light
    // rather than adding a row, so the 140px minimum stays useful.
    property <length> scale-w: 22px;
    property <length> bar-w: 12px;
    property <length> bar-gap: 3px;
    property <length> pair-w: 2 * root.bar-w + root.bar-gap;

    pure function y-of(db: float, height: length) -> length {
        return (1 - (db - root.floor-db) / (0 - root.floor-db)) * height;
    }

    pure function peak-text() -> string {
        if (Meters.hold-left < 0 && Meters.hold-right < 0) {
            return "–";
        }
        return "\{Math.round(root.floor-db + Fmt.clamp(Math.max(Meters.hold-left, Meters.hold-right), 0, 1) * (0 - root.floor-db))}";
    }

    VerticalLayout {
        // Preserve the other panes' header height and switcher position.
        // The column is too narrow for a name; the bars identify it.
        Rectangle {
            height: 52px;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    PaneSwitcher {
                        kind: PaneKind.meters;
                        seat: root.pane-seat;
                        removable: root.pane-removable;
                        picked(kind) => { root.pane-picked(kind); }
                        removed => { root.pane-removed(); }
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: root.bar-gap;

            // The held peak and clip light share the space over the bars.
            // A negative hold means no reading; clicking still clears clipping.
            HorizontalLayout {
                alignment: center;
                spacing: root.bar-gap;
                Rectangle { width: root.scale-w; }
                light := Rectangle {
                    width: root.pair-w;
                    height: 16px;
                    border-radius: 2px;
                    background: Meters.clipped ? Theme.danger : Theme.field;
                    border-width: 1px;
                    border-color: Meters.clipped ? Theme.danger : Theme.line;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.peak-text();
                        color: Theme.fg;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    light-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Meters.clip-cleared(); }
                    }
                    Tip {
                        text: Meters.clipped ? I18n.t("meters.clipped") : I18n.t("meters.clipLight");
                        active: light-touch.has-hover;
                    }
                }
            }

            // The bars, and the scale beside them.
            HorizontalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: root.bar-gap;

                scale := Rectangle {
                    width: root.scale-w;
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.line;
                    }
                    for db in root.ticks: Rectangle {
                        property <bool> major: Math.mod(db, 6) == 0;
                        x: parent.width - self.width;
                        y: Fmt.clamp(root.y-of(db, parent.height) / 1px, 0, Math.max(0, parent.height / 1px - 1)) * 1px;
                        width: self.major ? 4px : 2px;
                        height: 1px;
                        background: self.major ? Theme.fg-dim : Theme.line-strong;
                    }
                    for db in root.marks: Text {
                        // Keep labels apart when the pane is shortened. All
                        // ticks remain; the floor and full-scale numbers stay.
                        visible: parent.height >= 120px
                            || (parent.height >= 80px && (db == -12 || db == -48))
                            || db == 0 || db == -24 || db == -60;
                        x: parent.width - 5px - self.width;
                        y: Fmt.clamp((root.y-of(db, parent.height) - self.height / 2) / 1px,
                            0, Math.max(0, (parent.height - self.height) / 1px)) * 1px;
                        text: "\{db}";
                        color: Theme.fg-dim;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs-xs;
                    }
                }
                LevelMeter {
                    vertical: true;
                    thickness: root.bar-w;
                    value: Meters.left;
                    peak: Meters.hold-left;
                }
                LevelMeter {
                    vertical: true;
                    thickness: root.bar-w;
                    value: Meters.right;
                    peak: Meters.hold-right;
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: root.bar-gap;
                Rectangle {
                    width: root.scale-w;
                    Text {
                        x: parent.width - 5px - self.width;
                        text: "dB";
                        color: Theme.fg-dim;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs-xs;
                    }
                }
                Text {
                    width: root.bar-w;
                    text: "L";
                    color: Theme.fg-dim;
                    font-size: Theme.fs-xs;
                    horizontal-alignment: center;
                }
                Text {
                    width: root.bar-w;
                    text: "R";
                    color: Theme.fg-dim;
                    font-size: Theme.fs-xs;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
