# Original packaging maintainer: noxygalaxy <noxycraftyt@gmail.com>
pkgname=veycut
pkgver=${CONCAT_VERSION:?CONCAT_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
url="https://github.com/alirezap73/veycut"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${CONCAT_STAGE:?CONCAT_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/concat" "$pkgdir/opt/veycut/concat"
  install -d "$pkgdir/opt/veycut/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/veycut/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/veycut/concat "$@"\n' > "$pkgdir/usr/bin/veycut"
  chmod 755 "$pkgdir/usr/bin/veycut"
  install -Dm644 "$stage/concat.desktop" "$pkgdir/usr/share/applications/veycut.desktop"
  sed -i 's|^Exec=veycut|Exec=/opt/veycut/concat %U|' "$pkgdir/usr/share/applications/veycut.desktop"
  install -Dm644 "$stage/concat.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/veycut.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/veycut/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/veycut/THIRD_PARTY_NOTICES.md"
  install -Dm644 "$stage/LICENSE-EXCEPTIONS.md" "$pkgdir/usr/share/licenses/veycut/LICENSE-EXCEPTIONS.md"
  install -Dm644 "$stage/SOURCE-NOTICES.md" "$pkgdir/usr/share/licenses/veycut/SOURCE-NOTICES.md"
}
